# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Production site URL.
APP_URL="https://ordersphere.app"

# Ordersphere Partner Admin
# Use a long, unique password. Do NOT commit the real value to GitHub.
ADMIN_PASSWORD="CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD"

# Email notifications via Resend (optional but recommended).
# Set these in Netlify Site configuration > Environment variables.
ADMIN_EMAIL="you@example.com"
RESEND_API_KEY="re_xxxxxxxxx"
RESEND_FROM_EMAIL="Ordersphere <notifications@your-verified-domain.com>"
